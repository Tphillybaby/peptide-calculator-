{
    "framework": null,
    "crons": [
        {
            "path": "/api/cron/scrape-prices",
            "schedule": "0 6 * * *"
        },
        {
            "path": "/api/cron/scrape-prices",
            "schedule": "0 18 * * *"
        }
    ],
    "rewrites": [
        {
            "source": "/sitemap.xml",
            "destination": "/sitemap.xml"
        },
        {
            "source": "/robots.txt",
            "destination": "/robots.txt"
        },
        {
            "source": "/assets/(.*)",
            "destination": "/assets/$1"
        },
        {
            "source": "/encyclopedia/:slug",
            "destination": "/encyclopedia/:slug/index.html"
        },
        {
            "source": "/guides/:slug",
            "destination": "/guides/:slug/index.html"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ],
    "headers": [
        {
            "source": "/sitemap.xml",
            "headers": [
                {
                    "key": "Content-Type",
                    "value": "application/xml"
                },
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=3600, s-maxage=3600"
                }
            ]
        },
        {
            "source": "/assets/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        },
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "X-Robots-Tag",
                    "value": "index, follow"
                },
                {
                    "key": "X-Content-Type-Options",
                    "value": "nosniff"
                },
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=0, s-maxage=60, stale-while-revalidate=600"
                }
            ]
        },
        {
            "source": "/sw.js",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "no-store, max-age=0"
                }
            ]
        },
        {
            "source": "/push-events.js",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "no-cache, max-age=0"
                }
            ]
        },
        {
            "source": "/assets/index-DkweG_Fq.js",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "no-store, max-age=0"
                }
            ]
        },
        {
            "source": "/assets/index-CSUDe5kk.js",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "no-store, max-age=0"
                }
            ]
        }
    ],
    "buildCommand": "npm run build:full",
    "outputDirectory": "dist"
}
