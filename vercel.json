{
    "framework": null,
    "rewrites": [
        {
            "source": "/sitemap.xml",
            "destination": "/sitemap.xml"
        },
        {
            "source": "/robots.txt",
            "destination": "/robots.txt"
        },
        {
            "source": "/assets/(.*)",
            "destination": "/assets/$1"
        },
        {
            "source": "/encyclopedia/:slug",
            "destination": "/encyclopedia/:slug/index.html"
        },
        {
            "source": "/guides/:slug",
            "destination": "/guides/:slug/index.html"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ],
    "headers": [
        {
            "source": "/sitemap.xml",
            "headers": [
                {
                    "key": "Content-Type",
                    "value": "application/xml"
                },
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=3600, s-maxage=3600"
                }
            ]
        },
        {
            "source": "/assets/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        },
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "X-Robots-Tag",
                    "value": "index, follow"
                },
                {
                    "key": "X-Content-Type-Options",
                    "value": "nosniff"
                },
                {
                    "key": "Cache-Control",
                    "value": "no-cache, max-age=0, must-revalidate"
                }
            ]
        },
        {
            "source": "/sw.js",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "no-store, max-age=0"
                }
            ]
        },
        {
            "source": "/push-events.js",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "no-cache, max-age=0"
                }
            ]
        },
        {
            "source": "/assets/index-DkweG_Fq.js",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "no-store, max-age=0"
                }
            ]
        },
        {
            "source": "/assets/index-CSUDe5kk.js",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "no-store, max-age=0"
                }
            ]
        },
        {
            "source": "/recover.html",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "no-store, max-age=0"
                }
            ]
        },
        {
            "source": "/version.json",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "no-store, max-age=0"
                }
            ]
        },
        {
            "source": "/index.html",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "no-store, max-age=0"
                }
            ]
        }
    ],
    "buildCommand": "npm run build:full",
    "outputDirectory": "dist",
    "redirects": [
        {
            "source": "/encyclopedia/tb-500",
            "destination": "/encyclopedia/tb-500-thymosin-beta-4",
            "permanent": true
        },
        {
            "source": "/encyclopedia/ghk-cu",
            "destination": "/encyclopedia/ghk-cu-copper-peptide",
            "permanent": true
        },
        {
            "source": "/encyclopedia/pt-141",
            "destination": "/encyclopedia/pt-141-bremelanotide",
            "permanent": true
        },
        {
            "source": "/encyclopedia/mk-677",
            "destination": "/encyclopedia/mk-677-ibutamoren",
            "permanent": true
        },
        {
            "source": "/encyclopedia/cjc-1295",
            "destination": "/encyclopedia?search=CJC-1295",
            "permanent": true
        }
    ]
}
